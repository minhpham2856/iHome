<Window x:Class="iHome.UI.Views.Landlord.RoomTypeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thông tin loại phòng"
        Width="620" Height="920"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource ColorBackground}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="lbTitle" Text="Thêm loại phòng" Style="{StaticResource ManagerDialogTitleStyle}"/>
                <TextBlock Text="TÊN LOẠI PHÒNG" Style="{StaticResource ManagerDialogLabelStyle}"/>
                <TextBox x:Name="txtTypeName" Style="{StaticResource ManagerTextBoxStyle}" MaxLength="100"
                         KeyDown="txtTypeName_KeyDown"/>
                <TextBlock Text="SỐ NGƯỜI TỐI ĐA" Style="{StaticResource ManagerDialogLabelStyle}"/>
                <TextBox x:Name="txtMaxOccupancy" Style="{StaticResource ManagerTextBoxStyle}" MaxLength="3"
                         KeyDown="txtMaxOccupancy_KeyDown"/>
                <TextBlock Text="DIỆN TÍCH (m²)" Style="{StaticResource ManagerDialogLabelStyle}"/>
                <TextBox x:Name="txtArea" Style="{StaticResource ManagerTextBoxStyle}" MaxLength="10"
                         KeyDown="txtArea_KeyDown"/>
                <TextBlock Text="GIÁ THUÊ" Style="{StaticResource ManagerDialogLabelStyle}"/>
                <TextBox x:Name="txtBaseRent" Style="{StaticResource ManagerTextBoxStyle}" MaxLength="15"
                         KeyDown="txtBaseRent_KeyDown"/>
                <TextBlock Text="MÔ TẢ" Style="{StaticResource ManagerDialogLabelStyle}"/>
                <TextBox x:Name="txtDescription" Style="{StaticResource ManagerTextBoxStyle}" MaxLength="300"
                         Height="80" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalContentAlignment="Top" Padding="12,8"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="btnCancel" Content="Hủy" Style="{StaticResource ManagerSecondaryButtonStyle}" Click="btnCancel_Click"/>
            <Button x:Name="btnSave" Content="Lưu" Style="{StaticResource ManagerToolbarButtonStyle}" Click="btnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
