<Window x:Class="iHome.UI.Views.Landlord.RoomDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thông tin phòng"
        Width="520" Height="620"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource ColorBackground}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="lbTitle" Text="Thêm phòng" Style="{StaticResource ManagerDialogTitleStyle}"/>
                <TextBlock Text="SỐ PHÒNG" Style="{StaticResource ManagerDialogLabelStyle}"/>
                <TextBox x:Name="txtRoomNumber" Style="{StaticResource ManagerTextBoxStyle}" MaxLength="20"
                         KeyDown="txtRoomNumber_KeyDown"/>
                <TextBlock Text="LOẠI PHÒNG" Style="{StaticResource ManagerDialogLabelStyle}"/>
                <ComboBox x:Name="cbRoomType" Style="{StaticResource ManagerComboBoxStyle}"
                          DisplayMemberPath="Name" SelectedValuePath="Id"
                          SelectionChanged="cbRoomType_SelectionChanged"
                          KeyDown="cbRoomType_KeyDown"/>
                <TextBlock Text="DIỆN TÍCH / GIÁ (THEO LOẠI)" Style="{StaticResource ManagerDialogLabelStyle}"/>
                <TextBlock x:Name="lbTypeInfo" Style="{StaticResource ManagerDataGridTextStyle}" Margin="0,0,0,8"/>
                <TextBlock Text="TẦNG" Style="{StaticResource ManagerDialogLabelStyle}"/>
                <TextBox x:Name="txtFloor" Style="{StaticResource ManagerTextBoxStyle}" MaxLength="3"
                         KeyDown="txtFloor_KeyDown"/>
                <TextBlock Text="TRẠNG THÁI" Style="{StaticResource ManagerDialogLabelStyle}"/>
                <ComboBox x:Name="cbStatus" Style="{StaticResource ManagerComboBoxStyle}"
                          DisplayMemberPath="Name" SelectedValuePath="Code"
                          KeyDown="cbStatus_KeyDown"/>
                <TextBlock Text="GHI CHÚ" Style="{StaticResource ManagerDialogLabelStyle}"/>
                <TextBox x:Name="txtNotes" Style="{StaticResource ManagerTextBoxStyle}" MaxLength="300"
                         Height="70" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalContentAlignment="Top" Padding="12,8"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="btnCancel" Content="Hủy" Style="{StaticResource ManagerSecondaryButtonStyle}" Click="btnCancel_Click"/>
            <Button x:Name="btnSave" Content="Lưu" Style="{StaticResource ManagerToolbarButtonStyle}" Click="btnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
