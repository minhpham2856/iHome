<Page x:Class="iHome.UI.Views.Landlord.BuildingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Quản lý nhà trọ">

    <Grid Background="{StaticResource ColorBackground}" Margin="0" TextElement.FontFamily="Segoe UI">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Properties -->
        <Grid Grid.Column="0" Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="{StaticResource ColorSurface}"
                    BorderBrush="{StaticResource ColorBorder}" BorderThickness="0,0,1,1" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtSearch" Style="{StaticResource ManagerTextBoxStyle}"
                             Margin="0,0,12,0" VerticalAlignment="Center"
                             ToolTip="Tìm theo tên / địa chỉ"
                             TextChanged="txtSearch_TextChanged"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="btnAddProperty" Content="+ Thêm" Style="{StaticResource ManagerToolbarButtonStyle}" Click="btnAddProperty_Click"/>
                        <Button x:Name="btnEditProperty" Content="Sửa" Style="{StaticResource ManagerSecondaryButtonStyle}" Click="btnEditProperty_Click"/>
                        <Button x:Name="btnRefresh" Content="↻" Style="{StaticResource ManagerSecondaryButtonStyle}" Click="btnRefresh_Click" ToolTip="Làm mới"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource ManagerCardStyle}" Margin="0" Padding="0"
                    BorderThickness="0,0,1,0">
                <DataGrid x:Name="dgProperties" Style="{StaticResource ManagerDataGridStyle}"
                          CanUserSortColumns="True"
                          SelectionChanged="dgProperties_SelectionChanged"
                          MouseDoubleClick="dgProperties_MouseDoubleClick"
                          HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="TÊN NHÀ TRỌ" Binding="{Binding Name}" SortMemberPath="Name" Width="1.4*" MinWidth="100"/>
                        <DataGridTextColumn Header="ĐỊA CHỈ" Binding="{Binding Address}" SortMemberPath="Address" Width="1.6*" MinWidth="100"/>
                        <DataGridTextColumn Header="SỐ TÒA" Binding="{Binding BuildingCount}" SortMemberPath="BuildingCount" Width="0.7*" MinWidth="60"/>
                        <DataGridTemplateColumn Header="TRẠNG THÁI" SortMemberPath="IsActive" Width="1.1*" MinWidth="100"
                                                CellStyle="{StaticResource LandlordActiveStatusCellStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StatusDisplay}" Style="{StaticResource LandlordActiveStatusTextStyle}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- Right: Buildings -->
        <Grid Grid.Column="1" Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="{StaticResource ColorSurface}"
                    BorderBrush="{StaticResource ColorBorder}" BorderThickness="0,0,0,1" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="lbBuildingSection" Text="Tòa nhà" Style="{StaticResource ManagerSectionTitleStyle}"
                               Margin="0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="btnAddBuilding" Content="+ Thêm tòa" Style="{StaticResource ManagerToolbarButtonStyle}" Click="btnAddBuilding_Click" IsEnabled="False"/>
                        <Button x:Name="btnEditBuilding" Content="Sửa" Style="{StaticResource ManagerSecondaryButtonStyle}" Click="btnEditBuilding_Click" IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource ManagerCardStyle}" Margin="0" Padding="0" BorderThickness="0">
                <Grid>
                    <DataGrid x:Name="dgBuildings" Style="{StaticResource ManagerDataGridStyle}"
                              CanUserSortColumns="True"
                              MouseDoubleClick="dgBuildings_MouseDoubleClick"
                              HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TÊN TÒA" Binding="{Binding Name}" SortMemberPath="Name" Width="1.3*" MinWidth="90"/>
                            <DataGridTextColumn Header="SỐ TẦNG" Binding="{Binding NumberOfFloors}" SortMemberPath="NumberOfFloors" Width="0.7*" MinWidth="60"/>
                            <DataGridTextColumn Header="QUẢN LÝ" Binding="{Binding ManagerName}" SortMemberPath="ManagerName" Width="1.3*" MinWidth="90"/>
                            <DataGridTemplateColumn Header="TRẠNG THÁI" SortMemberPath="IsActive" Width="1.1*" MinWidth="100"
                                                    CellStyle="{StaticResource LandlordActiveStatusCellStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusDisplay}" Style="{StaticResource LandlordActiveStatusTextStyle}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border x:Name="brdBuildingState" Background="{StaticResource ColorOverlay}" Visibility="Visible">
                        <TextBlock Text="Chọn một nhà trọ để xem và quản lý tòa nhà." Style="{StaticResource ManagerStateTextStyle}"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
