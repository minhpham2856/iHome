<Window x:Class="iHome.UI.Views.Landlord.ServiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thông tin dịch vụ"
        Width="520" Height="620"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource ColorBackground}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="lbTitle" Text="Thêm dịch vụ" Style="{StaticResource ManagerDialogTitleStyle}"/>
                <TextBlock Text="TÊN DỊCH VỤ" Style="{StaticResource ManagerDialogLabelStyle}"/>
                <TextBox x:Name="txtServiceName" Style="{StaticResource ManagerTextBoxStyle}" MaxLength="100"
                         KeyDown="txtServiceName_KeyDown"/>
                <TextBlock Text="ĐƠN VỊ TÍNH" Style="{StaticResource ManagerDialogLabelStyle}"/>
                <TextBox x:Name="txtUnit" Style="{StaticResource ManagerTextBoxStyle}" MaxLength="20"
                         KeyDown="txtUnit_KeyDown"/>
                <TextBlock Text="ĐƠN GIÁ" Style="{StaticResource ManagerDialogLabelStyle}"/>
                <TextBox x:Name="txtUnitPrice" Style="{StaticResource ManagerTextBoxStyle}" MaxLength="15"
                         KeyDown="txtUnitPrice_KeyDown"/>
                <TextBlock Text="CÁCH TÍNH" Style="{StaticResource ManagerDialogLabelStyle}"/>
                <ComboBox x:Name="cbCalculationMethod" Style="{StaticResource ManagerComboBoxStyle}"
                          DisplayMemberPath="DisplayName" SelectedValuePath="Value"
                          KeyDown="cbCalculationMethod_KeyDown"/>
                <CheckBox x:Name="chkIsActive" Content="Đang hoạt động" Margin="0,16,0,0"
                          Foreground="{StaticResource ColorTextPrimary}" IsChecked="True"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="btnCancel" Content="Hủy" Style="{StaticResource ManagerSecondaryButtonStyle}" Click="btnCancel_Click"/>
            <Button x:Name="btnSave" Content="Lưu" Style="{StaticResource ManagerToolbarButtonStyle}" Click="btnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
