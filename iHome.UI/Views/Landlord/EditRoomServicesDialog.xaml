<Window x:Class="iHome.UI.Views.Landlord.EditRoomServicesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sửa dịch vụ theo phòng"
        Width="480" Height="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource ColorBackground}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Sửa dịch vụ theo phòng" Style="{StaticResource ManagerDialogTitleStyle}"/>
            <TextBlock Text="PHÒNG" Style="{StaticResource ManagerDialogLabelStyle}"/>
            <ComboBox x:Name="cbRoom" Style="{StaticResource ManagerComboBoxStyle}"
                      DisplayMemberPath="DisplayName" SelectionChanged="cbRoom_SelectionChanged"
                      KeyDown="cbRoom_KeyDown"/>
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="DỊCH VỤ" Style="{StaticResource ManagerDialogLabelStyle}" Margin="0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Tất cả" Style="{StaticResource ManagerSecondaryButtonStyle}" Click="btnSelectAll_Click" Padding="8,4"/>
                    <Button Content="Bỏ" Style="{StaticResource ManagerSecondaryButtonStyle}" Click="btnClear_Click" Padding="8,4"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource ManagerCardStyle}" Margin="0,8,0,0" Padding="8">
            <ListBox x:Name="lstServices" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  Margin="4,6" Foreground="{StaticResource ColorTextPrimary}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="btnCancel" Content="Hủy" Style="{StaticResource ManagerSecondaryButtonStyle}" Click="btnCancel_Click"/>
            <Button x:Name="btnSave" Content="Lưu" Style="{StaticResource ManagerToolbarButtonStyle}" Click="btnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
