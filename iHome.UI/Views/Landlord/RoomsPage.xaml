<Page x:Class="iHome.UI.Views.Landlord.RoomsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Quản lý phòng">

    <Grid Background="{StaticResource ColorBackground}" Margin="0" TextElement.FontFamily="Segoe UI">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource ColorSurface}"
                BorderBrush="{StaticResource ColorBorder}" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="NHÀ TRỌ" Style="{StaticResource ManagerFilterLabelStyle}"/>
                    <ComboBox x:Name="cbProperty" Style="{StaticResource ManagerComboBoxStyle}"
                              DisplayMemberPath="Name" SelectionChanged="cbProperty_SelectionChanged"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="TÒA NHÀ" Style="{StaticResource ManagerFilterLabelStyle}"/>
                    <ComboBox x:Name="cbBuilding" Style="{StaticResource ManagerComboBoxStyle}"
                              DisplayMemberPath="Name" SelectionChanged="cbBuilding_SelectionChanged"/>
                </StackPanel>
                <Button x:Name="btnRefresh" Grid.Column="3" Content="↻" Margin="12,18,0,0"
                        Style="{StaticResource ManagerSecondaryButtonStyle}" Click="btnRefresh_Click" ToolTip="Làm mới"
                        VerticalAlignment="Top"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.4*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Room types -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Background="{StaticResource ColorSurface}"
                        BorderBrush="{StaticResource ColorBorder}" BorderThickness="0,0,1,1" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Loại phòng" Style="{StaticResource ManagerSectionTitleStyle}"
                                   Margin="0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="btnAddRoomType" Content="+ Thêm" Style="{StaticResource ManagerToolbarButtonStyle}"
                                    Click="btnAddRoomType_Click" IsEnabled="False"/>
                            <Button x:Name="btnEditRoomType" Content="Sửa" Style="{StaticResource ManagerSecondaryButtonStyle}"
                                    Click="btnEditRoomType_Click" IsEnabled="False"/>
                            <Button x:Name="btnDeleteRoomType" Content="Xóa" Style="{StaticResource ManagerDangerButtonStyle}"
                                    Click="btnDeleteRoomType_Click" IsEnabled="False"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource ManagerCardStyle}" Margin="0" Padding="0"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <DataGrid x:Name="dgRoomTypes" Style="{StaticResource ManagerDataGridStyle}"
                                  CanUserSortColumns="True"
                                  MouseDoubleClick="dgRoomTypes_MouseDoubleClick"
                                  HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="TÊN LOẠI" Binding="{Binding TypeName}" SortMemberPath="TypeName" Width="1.3*" MinWidth="100"/>
                                <DataGridTextColumn Header="SỨC CHỨA" Binding="{Binding MaxOccupancy}" SortMemberPath="MaxOccupancy" Width="0.7*" MinWidth="65"/>
                                <DataGridTextColumn Header="DIỆN TÍCH" Binding="{Binding Area, StringFormat={}{0:N1} m²}" SortMemberPath="Area" Width="0.9*" MinWidth="80"/>
                                <DataGridTextColumn Header="GIÁ THUÊ" Binding="{Binding BaseRent, StringFormat={}{0:N0} đ}" SortMemberPath="BaseRent" Width="1.1*" MinWidth="95"/>
                                <DataGridTextColumn Header="SỐ PHÒNG" Binding="{Binding RoomCount}" SortMemberPath="RoomCount" Width="0.7*" MinWidth="65"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border x:Name="brdRoomTypeState" Background="{StaticResource ColorOverlay}" Visibility="Visible">
                            <TextBlock Text="Chọn tòa nhà để quản lý loại phòng." Style="{StaticResource ManagerStateTextStyle}"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Right: Rooms -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Background="{StaticResource ColorSurface}"
                        BorderBrush="{StaticResource ColorBorder}" BorderThickness="0,0,0,1" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="lbRoomSection" Text="Phòng" Style="{StaticResource ManagerSectionTitleStyle}"
                                   Margin="0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="btnAddRoom" Content="+ Thêm phòng" Style="{StaticResource ManagerToolbarButtonStyle}"
                                    Click="btnAddRoom_Click" IsEnabled="False"/>
                            <Button x:Name="btnEditRoom" Content="Sửa" Style="{StaticResource ManagerSecondaryButtonStyle}"
                                    Click="btnEditRoom_Click" IsEnabled="False"/>
                            <Button x:Name="btnViewRoom" Content="Xem" Style="{StaticResource ManagerSecondaryButtonStyle}"
                                    Click="btnViewRoom_Click" IsEnabled="False"/>
                            <Button x:Name="btnDeleteRoom" Content="Xóa" Style="{StaticResource ManagerDangerButtonStyle}"
                                    Click="btnDeleteRoom_Click" IsEnabled="False"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource ManagerCardStyle}" Margin="0" Padding="0" BorderThickness="0">
                    <Grid>
                        <DataGrid x:Name="dgRooms" Style="{StaticResource ManagerDataGridStyle}"
                                  CanUserSortColumns="True"
                                  MouseDoubleClick="dgRooms_MouseDoubleClick"
                                  HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="TÒA" Binding="{Binding BuildingName}" SortMemberPath="BuildingName" Width="0.9*" MinWidth="70"/>
                                <DataGridTextColumn Header="SỐ PHÒNG" Binding="{Binding RoomNumber}" SortMemberPath="RoomNumber" Width="0.9*" MinWidth="70"/>
                                <DataGridTextColumn Header="LOẠI" Binding="{Binding RoomTypeName}" SortMemberPath="RoomTypeName" Width="1.2*" MinWidth="90"/>
                                <DataGridTextColumn Header="TẦNG" Binding="{Binding Floor}" SortMemberPath="Floor" Width="0.5*" MinWidth="50"/>
                                <DataGridTextColumn Header="SỐ NGƯỜI" Binding="{Binding CurrentOccupancy}" SortMemberPath="CurrentOccupancy" Width="0.7*" MinWidth="65"/>
                                <DataGridTemplateColumn Header="TRẠNG THÁI" SortMemberPath="StatusDisplay" Width="1*" MinWidth="95"
                                                        CellStyle="{StaticResource LandlordRoomStatusCellStyle}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StatusDisplay}" Style="{StaticResource LandlordRoomStatusTextStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border x:Name="brdRoomState" Background="{StaticResource ColorOverlay}" Visibility="Visible">
                            <TextBlock Text="Chọn tòa nhà để xem và quản lý phòng." Style="{StaticResource ManagerStateTextStyle}"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
