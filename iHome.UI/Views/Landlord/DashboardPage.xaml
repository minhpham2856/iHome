<Page x:Class="iHome.UI.Views.Landlord.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="1000"
      Title="Bảng điều khiển">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Background="{StaticResource ColorBackground}">
        <StackPanel Margin="12,8,12,16">

            <Grid Margin="4,0,4,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Tổng quan" Style="{StaticResource ChartTitleStyle}" VerticalAlignment="Center" Margin="0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Nhà trọ" Style="{StaticResource FilterInlineLabelStyle}"/>
                    <ComboBox x:Name="cbProperty"
                              Style="{StaticResource ManagerComboBoxStyle}"
                              Width="220"
                              DisplayMemberPath="Name"
                              VerticalAlignment="Center"
                              SelectionChanged="cbProperty_SelectionChanged"/>
                </StackPanel>
            </Grid>

            <UniformGrid Columns="5" Margin="0,0,0,16">
                <Border Style="{StaticResource CardStyle}" Margin="4">
                    <StackPanel>
                        <TextBlock Style="{StaticResource KpiTitleStyle}" Text="Tổng nhà trọ"/>
                        <TextBlock x:Name="lbTotalProperties" Style="{StaticResource KpiValueStyle}" Text="0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="4">
                    <StackPanel>
                        <TextBlock Style="{StaticResource KpiTitleStyle}" Text="Tổng tòa nhà"/>
                        <TextBlock x:Name="lbTotalBuildings" Style="{StaticResource KpiValueStyle}" Text="0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="4">
                    <StackPanel>
                        <TextBlock Style="{StaticResource KpiTitleStyle}" Text="Tổng phòng"/>
                        <TextBlock x:Name="lbTotalRooms" Style="{StaticResource KpiValueStyle}" Text="0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="4">
                    <StackPanel>
                        <TextBlock Style="{StaticResource KpiTitleStyle}" Text="Đang ở"/>
                        <TextBlock x:Name="lbOccupiedRooms" Style="{StaticResource KpiValueStyle}" Text="0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="4">
                    <StackPanel>
                        <TextBlock Style="{StaticResource KpiTitleStyle}" Text="Trống"/>
                        <TextBlock x:Name="lbVacantRooms" Style="{StaticResource KpiValueStyle}" Text="0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="4">
                    <StackPanel>
                        <TextBlock Style="{StaticResource KpiTitleStyle}" Text="Tổng khách"/>
                        <TextBlock x:Name="lbTotalTenants" Style="{StaticResource KpiValueStyle}" Text="0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="4">
                    <StackPanel>
                        <TextBlock Style="{StaticResource KpiTitleStyle}" Text="Hợp đồng hoạt động"/>
                        <TextBlock x:Name="lbActiveContracts" Style="{StaticResource KpiValueStyle}" Text="0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="4">
                    <StackPanel>
                        <TextBlock Style="{StaticResource KpiTitleStyle}" Text="Doanh thu tháng"/>
                        <TextBlock x:Name="lbMonthlyRevenue" Style="{StaticResource KpiValueStyle}" Text="0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="4">
                    <StackPanel>
                        <TextBlock Style="{StaticResource KpiTitleStyle}" Text="Chưa thanh toán"/>
                        <TextBlock x:Name="lbOutstanding" Style="{StaticResource KpiValueStyle}" Text="0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="4">
                    <StackPanel>
                        <TextBlock Style="{StaticResource KpiTitleStyle}" Text="Quá hạn"/>
                        <TextBlock x:Name="lbOverdue" Style="{StaticResource KpiValueStyle}" Text="0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource CardStyle}" Margin="4,0,4,16" Padding="16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="lbRevenueTitle" Style="{StaticResource ChartTitleStyle}"
                                   Text="Doanh thu" VerticalAlignment="Center" Margin="0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ComboBox x:Name="cbRevenueRange"
                                      Style="{StaticResource ManagerComboBoxStyle}"
                                      Width="140"
                                      DisplayMemberPath="Name"
                                      VerticalAlignment="Center"
                                      SelectionChanged="cbRevenueRange_SelectionChanged"/>
                            <TextBlock Text="Từ" Style="{StaticResource FilterInlineLabelStyle}" Margin="12,0,6,0"/>
                            <DatePicker x:Name="dpRevenueFrom"
                                        Style="{StaticResource FilterDatePickerStyle}"
                                        Width="130"
                                        VerticalAlignment="Center"
                                        SelectedDateChanged="dpRevenue_SelectedDateChanged"/>
                            <TextBlock Text="Đến" Style="{StaticResource FilterInlineLabelStyle}" Margin="10,0,6,0"/>
                            <DatePicker x:Name="dpRevenueTo"
                                        Style="{StaticResource FilterDatePickerStyle}"
                                        Width="130"
                                        VerticalAlignment="Center"
                                        SelectedDateChanged="dpRevenue_SelectedDateChanged"/>
                        </StackPanel>
                    </Grid>
                    <lvc:CartesianChart x:Name="chartRevenue" Height="260" LegendLocation="None"/>
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardStyle}" Margin="4,0" Padding="16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource ChartTitleStyle}" Text="Tình trạng phòng"/>
                        <lvc:PieChart x:Name="chartRoomStatus" Height="240" LegendLocation="Right"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="4,0" Padding="16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource ChartTitleStyle}" Text="Tình trạng hợp đồng"/>
                        <lvc:PieChart x:Name="chartContractStatus" Height="240" LegendLocation="Right"/>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
