<Page x:Class="iHome.UI.Views.Landlord.ServicesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Quản lý dịch vụ">

    <Grid Background="{StaticResource ColorBackground}" Margin="0" TextElement.FontFamily="Segoe UI">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource ColorSurface}"
                BorderBrush="{StaticResource ColorBorder}" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="NHÀ TRỌ" Style="{StaticResource ManagerFilterLabelStyle}"/>
                    <ComboBox x:Name="cboProperty" Style="{StaticResource ManagerComboBoxStyle}"
                              DisplayMemberPath="Name" SelectionChanged="cboProperty_SelectionChanged"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="TÒA NHÀ" Style="{StaticResource ManagerFilterLabelStyle}"/>
                    <ComboBox x:Name="cboBuilding" Style="{StaticResource ManagerComboBoxStyle}"
                              DisplayMemberPath="Name" SelectionChanged="cboBuilding_SelectionChanged"/>
                </StackPanel>
                <Button x:Name="btnRefresh" Grid.Column="3" Content="↻" Margin="12,18,0,0"
                        Style="{StaticResource ManagerSecondaryButtonStyle}" Click="btnRefresh_Click" ToolTip="Làm mới"
                        VerticalAlignment="Top"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: service catalog -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Background="{StaticResource ColorSurface}"
                        BorderBrush="{StaticResource ColorBorder}" BorderThickness="0,0,1,1" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Loại dịch vụ" Style="{StaticResource ManagerSectionTitleStyle}"
                                   Margin="0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="btnAdd" Content="+ Thêm" Style="{StaticResource ManagerToolbarButtonStyle}"
                                    Click="btnAdd_Click" IsEnabled="False"/>
                            <Button x:Name="btnEdit" Content="Sửa" Style="{StaticResource ManagerSecondaryButtonStyle}"
                                    Click="btnEdit_Click" IsEnabled="False"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource ManagerCardStyle}" Margin="0" Padding="0"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <DataGrid x:Name="dgServices" Style="{StaticResource ManagerDataGridStyle}"
                                  CanUserSortColumns="True"
                                  MouseDoubleClick="dgServices_MouseDoubleClick"
                                  SelectionChanged="dgServices_SelectionChanged"
                                  HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="DỊCH VỤ" Binding="{Binding ServiceName}" SortMemberPath="ServiceName" Width="1.3*" MinWidth="100"/>
                                <DataGridTextColumn Header="ĐƠN VỊ" Binding="{Binding Unit}" SortMemberPath="Unit" Width="0.7*" MinWidth="60"/>
                                <DataGridTextColumn Header="ĐƠN GIÁ" Binding="{Binding UnitPrice, StringFormat={}{0:N0} đ}" SortMemberPath="UnitPrice" Width="1*" MinWidth="90"/>
                                <DataGridTextColumn Header="CÁCH TÍNH" Binding="{Binding CalculationMethodDisplay}" SortMemberPath="CalculationMethodDisplay" Width="1.2*" MinWidth="110"/>
                                <DataGridTemplateColumn Header="TRẠNG THÁI" SortMemberPath="IsActive" Width="1*" MinWidth="95"
                                                        CellStyle="{StaticResource LandlordActiveStatusCellStyle}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StatusDisplay}" Style="{StaticResource LandlordActiveStatusTextStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border x:Name="brdServiceState" Background="{StaticResource ColorOverlay}" Visibility="Visible">
                            <TextBlock Text="Chọn nhà trọ để quản lý loại dịch vụ." Style="{StaticResource ManagerStateTextStyle}"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Right: rooms + assignments -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Background="{StaticResource ColorSurface}"
                        BorderBrush="{StaticResource ColorBorder}" BorderThickness="0,0,0,1" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="lblRoomSection" Text="Phòng &amp; gán dịch vụ" Style="{StaticResource ManagerSectionTitleStyle}"
                                   Margin="0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="btnEditRoom" Content="Sửa" Style="{StaticResource ManagerSecondaryButtonStyle}"
                                    Click="btnEditRoom_Click" IsEnabled="False"/>
                            <Button x:Name="btnAssign" Content="Gán nhiều…" Style="{StaticResource ManagerToolbarButtonStyle}"
                                    Click="btnAssign_Click" IsEnabled="False"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource ManagerCardStyle}" Margin="0" Padding="0" BorderThickness="0">
                    <Grid>
                        <DataGrid x:Name="dgRooms" Style="{StaticResource ManagerDataGridStyle}"
                                  CanUserSortColumns="True"
                                  MouseDoubleClick="dgRooms_MouseDoubleClick"
                                  SelectionChanged="dgRooms_SelectionChanged"
                                  HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="SỐ PHÒNG" Binding="{Binding RoomNumber}" SortMemberPath="RoomNumber" Width="0.9*" MinWidth="70"/>
                                <DataGridTextColumn Header="TẦNG" Binding="{Binding Floor}" SortMemberPath="Floor" Width="0.6*" MinWidth="50"/>
                                <DataGridTextColumn Header="DỊCH VỤ ĐÃ GÁN" Binding="{Binding AssignedServicesSummary}" SortMemberPath="AssignedServicesSummary" Width="2*" MinWidth="160"/>
                                <DataGridTextColumn Header="SỐ DV" Binding="{Binding AssignedCount}" SortMemberPath="AssignedCount" Width="0.6*" MinWidth="55"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border x:Name="brdRoomState" Background="{StaticResource ColorOverlay}" Visibility="Visible">
                            <TextBlock Text="Chọn tòa để gán dịch vụ cho phòng." Style="{StaticResource ManagerStateTextStyle}"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
