<Page x:Class="iHome.UI.Views.Landlord.ManagersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Quản lý nhân viên">

    <Grid Background="{StaticResource ColorBackground}" Margin="0" TextElement.FontFamily="Segoe UI">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource ColorSurface}"
                BorderBrush="{StaticResource ColorBorder}" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Nhân viên quản lý" Style="{StaticResource ManagerSectionTitleStyle}"
                           Margin="0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="btnAdd" Content="+ Thêm" Style="{StaticResource ManagerToolbarButtonStyle}"
                            Click="btnAdd_Click"/>
                    <Button x:Name="btnEdit" Content="Sửa" Style="{StaticResource ManagerSecondaryButtonStyle}"
                            Click="btnEdit_Click" IsEnabled="False"/>
                    <Button x:Name="btnDelete" Content="Xóa" Style="{StaticResource ManagerDangerButtonStyle}"
                            Click="btnDelete_Click" IsEnabled="False"/>
                    <Button x:Name="btnRefresh" Content="↻" Style="{StaticResource ManagerSecondaryButtonStyle}"
                            Click="btnRefresh_Click" ToolTip="Làm mới"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource ManagerCardStyle}" Margin="0" Padding="0" BorderThickness="0">
            <Grid>
                <DataGrid x:Name="dgManagers" Style="{StaticResource ManagerDataGridStyle}"
                          CanUserSortColumns="True"
                          MouseDoubleClick="dgManagers_MouseDoubleClick"
                          SelectionChanged="dgManagers_SelectionChanged"
                          HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="HỌ TÊN" Binding="{Binding FullName}" SortMemberPath="FullName" Width="1.2*" MinWidth="110"/>
                        <DataGridTextColumn Header="TÀI KHOẢN" Binding="{Binding Username}" SortMemberPath="Username" Width="1*" MinWidth="90"/>
                        <DataGridTextColumn Header="EMAIL" Binding="{Binding Email}" SortMemberPath="Email" Width="1.3*" MinWidth="130"/>
                        <DataGridTextColumn Header="NHÀ TRỌ" Binding="{Binding PropertyName}" SortMemberPath="PropertyName" Width="1.1*" MinWidth="100"/>
                        <DataGridTextColumn Header="TÒA" Binding="{Binding AssignedBuildingsSummary}" SortMemberPath="AssignedBuildingsSummary" Width="1.4*" MinWidth="120"/>
                        <DataGridTemplateColumn Header="TRẠNG THÁI" SortMemberPath="IsActive" Width="1*" MinWidth="100"
                                                CellStyle="{StaticResource LandlordActiveStatusCellStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StatusDisplay}" Style="{StaticResource LandlordActiveStatusTextStyle}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <Border x:Name="brdState" Background="{StaticResource ColorOverlay}" Visibility="Collapsed">
                    <TextBlock Text="Chưa có nhân viên. Bấm + Thêm để tạo." Style="{StaticResource ManagerStateTextStyle}"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
