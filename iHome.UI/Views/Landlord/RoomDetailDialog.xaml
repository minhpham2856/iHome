<Window x:Class="iHome.UI.Views.Landlord.RoomDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chi tiết phòng"
        Width="520" Height="620"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource ColorBackground}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="lbTitle" Text="Chi tiết phòng" Style="{StaticResource ManagerDialogTitleStyle}"/>

        <Border Grid.Row="1" Style="{StaticResource ManagerCardStyle}" Margin="0,0,0,12" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,12,8">
                    <TextBlock Text="NHÀ TRỌ" Style="{StaticResource ManagerFilterLabelStyle}"/>
                    <TextBlock x:Name="lbProperty" Style="{StaticResource ManagerDataGridStrongTextStyle}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,0,8">
                    <TextBlock Text="TÒA NHÀ" Style="{StaticResource ManagerFilterLabelStyle}"/>
                    <TextBlock x:Name="lbBuilding" Style="{StaticResource ManagerDataGridStrongTextStyle}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,0,12,8">
                    <TextBlock Text="SỐ PHÒNG" Style="{StaticResource ManagerFilterLabelStyle}"/>
                    <TextBlock x:Name="lbRoomNumber" Style="{StaticResource ManagerDataGridLinkTextStyle}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                    <TextBlock Text="LOẠI PHÒNG" Style="{StaticResource ManagerFilterLabelStyle}"/>
                    <TextBlock x:Name="lbRoomType" Style="{StaticResource ManagerDataGridTextStyle}"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,0,12,8">
                    <TextBlock Text="TẦNG" Style="{StaticResource ManagerFilterLabelStyle}"/>
                    <TextBlock x:Name="lbFloor" Style="{StaticResource ManagerDataGridTextStyle}"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,8">
                    <TextBlock Text="DIỆN TÍCH" Style="{StaticResource ManagerFilterLabelStyle}"/>
                    <TextBlock x:Name="lbArea" Style="{StaticResource ManagerDataGridTextStyle}"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Margin="0,0,12,8">
                    <TextBlock Text="GIÁ THUÊ" Style="{StaticResource ManagerFilterLabelStyle}"/>
                    <TextBlock x:Name="lbBaseRent" Style="{StaticResource ManagerDataGridTextStyle}"/>
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,8">
                    <TextBlock Text="TRẠNG THÁI" Style="{StaticResource ManagerFilterLabelStyle}"/>
                    <TextBlock x:Name="lbStatus" Style="{StaticResource ManagerDataGridTextStyle}"/>
                </StackPanel>

                <StackPanel Grid.Row="4" Margin="0,0,12,8">
                    <TextBlock Text="SỨC CHỨA" Style="{StaticResource ManagerFilterLabelStyle}"/>
                    <TextBlock x:Name="lbOccupancy" Style="{StaticResource ManagerDataGridTextStyle}"/>
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,0,0,8">
                    <TextBlock Text="GHI CHÚ" Style="{StaticResource ManagerFilterLabelStyle}"/>
                    <TextBlock x:Name="lbNotes" Style="{StaticResource ManagerDataGridTextStyle}" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource ManagerCardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="KHÁCH THUÊ HIỆN TẠI" Style="{StaticResource ManagerSectionTitleStyle}"
                           Margin="16,12,16,8"/>
                <DataGrid x:Name="dgTenants" Grid.Row="1" Style="{StaticResource ManagerDataGridStyle}"
                          CanUserSortColumns="True" Margin="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="HỌ TÊN" Binding="{Binding FullName}" Width="1.4*" MinWidth="120"/>
                        <DataGridTextColumn Header="SĐT" Binding="{Binding PhoneNumber}" Width="1*" MinWidth="90"/>
                        <DataGridTextColumn Header="CCCD" Binding="{Binding IdCardNumber}" Width="1.1*" MinWidth="100"/>
                        <DataGridTextColumn Header="EMAIL" Binding="{Binding Email}" Width="1.3*" MinWidth="110"/>
                        <DataGridTextColumn Header="VAI TRÒ" Binding="{Binding RoleDisplay}" Width="1.1*" MinWidth="110"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Border x:Name="brdNoTenants" Grid.Row="1" Background="{StaticResource ColorOverlay}" Visibility="Collapsed">
                    <TextBlock Text="Phòng hiện không có khách thuê." Style="{StaticResource ManagerStateTextStyle}"/>
                </Border>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="btnClose" Content="Đóng" Style="{StaticResource ManagerToolbarButtonStyle}" Click="btnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
