<Window x:Class="iHome.UI.Views.Landlord.ManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thông tin nhân viên"
        Width="520" Height="620"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource ColorBackground}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="lblTitle" Text="Thêm nhân viên" Style="{StaticResource ManagerDialogTitleStyle}"/>
                <TextBlock Text="HỌ VÀ TÊN" Style="{StaticResource ManagerDialogLabelStyle}"/>
                <TextBox x:Name="txtFullName" Style="{StaticResource ManagerTextBoxStyle}" MaxLength="100"
                         KeyDown="txtFullName_KeyDown"/>
                <TextBlock Text="EMAIL" Style="{StaticResource ManagerDialogLabelStyle}"/>
                <TextBox x:Name="txtEmail" Style="{StaticResource ManagerTextBoxStyle}" MaxLength="150"
                         KeyDown="txtEmail_KeyDown"/>
                <TextBlock Text="SỐ ĐIỆN THOẠI" Style="{StaticResource ManagerDialogLabelStyle}"/>
                <TextBox x:Name="txtPhone" Style="{StaticResource ManagerTextBoxStyle}" MaxLength="20"
                         KeyDown="txtPhone_KeyDown"/>
                <TextBlock x:Name="lblAccountHint" Text="Hệ thống sẽ tự tạo tài khoản (vd: binhnv123456) và gửi mật khẩu tạm qua email."
                           Style="{StaticResource ManagerPageDescriptionStyle}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                <CheckBox x:Name="chkIsActive" Content="Đang hoạt động" Margin="0,12,0,0"
                          Foreground="{StaticResource ColorTextPrimary}" IsChecked="True" Visibility="Collapsed"/>

                <TextBlock Text="NHÀ TRỌ" Style="{StaticResource ManagerDialogLabelStyle}"/>
                <ComboBox x:Name="cbProperty"
                          Style="{StaticResource ManagerComboBoxStyle}"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          SelectionChanged="cbProperty_SelectionChanged"/>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="PHÂN CÔNG TÒA NHÀ (TÙY CHỌN)" Style="{StaticResource ManagerDialogLabelStyle}" Margin="0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Tất cả" Style="{StaticResource ManagerSecondaryButtonStyle}" Click="btnSelectAll_Click" Padding="8,4"/>
                        <Button Content="Bỏ" Style="{StaticResource ManagerSecondaryButtonStyle}" Click="btnClear_Click" Padding="8,4"/>
                    </StackPanel>
                </Grid>
                <Border Style="{StaticResource ManagerCardStyle}" Margin="0,8,0,0" Padding="8" Height="200">
                    <ListBox x:Name="lstBuildings" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding DisplayName}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          IsEnabled="{Binding CanSelect}"
                                          Margin="4,6" Foreground="{StaticResource ColorTextPrimary}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="btnCancel" Content="Hủy" Style="{StaticResource ManagerSecondaryButtonStyle}" Click="btnCancel_Click"/>
            <Button x:Name="btnSave" Content="Lưu" Style="{StaticResource ManagerToolbarButtonStyle}" Click="btnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
