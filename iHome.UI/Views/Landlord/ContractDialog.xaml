<Window x:Class="iHome.UI.Views.Landlord.ContractDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cập nhật hợp đồng"
        Width="480" Height="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource ColorBackground}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="lbTitle" Text="Cập nhật hợp đồng" Style="{StaticResource ManagerDialogTitleStyle}"/>
                <TextBlock Text="VỊ TRÍ" Style="{StaticResource ManagerDialogLabelStyle}"/>
                <TextBlock x:Name="lbLocation" Style="{StaticResource ManagerPageDescriptionStyle}" TextWrapping="Wrap"/>
                <TextBlock Text="NGƯỜI THUÊ CHÍNH" Style="{StaticResource ManagerDialogLabelStyle}"/>
                <TextBlock x:Name="lbMainTenant" Style="{StaticResource ManagerPageDescriptionStyle}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="NGÀY BẮT ĐẦU" Style="{StaticResource ManagerDialogLabelStyle}"/>
                        <DatePicker x:Name="dpStart" Style="{StaticResource ManagerDatePickerStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="NGÀY KẾT THÚC" Style="{StaticResource ManagerDialogLabelStyle}"/>
                        <DatePicker x:Name="dpEnd" Style="{StaticResource ManagerDatePickerStyle}"/>
                    </StackPanel>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="TIỀN THUÊ / THÁNG" Style="{StaticResource ManagerDialogLabelStyle}"/>
                        <TextBox x:Name="txtRent" Style="{StaticResource ManagerTextBoxStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="TIỀN CỌC" Style="{StaticResource ManagerDialogLabelStyle}"/>
                        <TextBox x:Name="txtDeposit" Style="{StaticResource ManagerTextBoxStyle}"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="TRẠNG THÁI" Style="{StaticResource ManagerDialogLabelStyle}"/>
                <ComboBox x:Name="cbStatus" Style="{StaticResource ManagerComboBoxStyle}" DisplayMemberPath="Name"/>
                <TextBlock Text="GHI CHÚ" Style="{StaticResource ManagerDialogLabelStyle}"/>
                <TextBox x:Name="txtNotes" Style="{StaticResource ManagerTextBoxStyle}" MaxLength="300"
                         AcceptsReturn="True" Height="72" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="btnCancel" Content="Hủy" Style="{StaticResource ManagerSecondaryButtonStyle}" Click="btnCancel_Click"/>
            <Button x:Name="btnSave" Content="Lưu" Style="{StaticResource ManagerToolbarButtonStyle}" Click="btnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
