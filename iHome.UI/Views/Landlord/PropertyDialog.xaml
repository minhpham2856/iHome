<Window x:Class="iHome.UI.Views.Landlord.PropertyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thông tin nhà trọ"
        Width="520" Height="620"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource ColorBackground}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="lbTitle" Text="Thêm nhà trọ" Style="{StaticResource ManagerDialogTitleStyle}"/>
                <TextBlock Text="TÊN NHÀ TRỌ" Style="{StaticResource ManagerDialogLabelStyle}"/>
                <TextBox x:Name="txtName" Style="{StaticResource ManagerTextBoxStyle}" MaxLength="150"
                         KeyDown="txtName_KeyDown"/>
                <TextBlock Text="ĐỊA CHỈ" Style="{StaticResource ManagerDialogLabelStyle}"/>
                <TextBox x:Name="txtAddress" Style="{StaticResource ManagerTextBoxStyle}" MaxLength="300"
                         KeyDown="txtAddress_KeyDown"/>
                <TextBlock Text="MÔ TẢ" Style="{StaticResource ManagerDialogLabelStyle}"/>
                <TextBox x:Name="txtDescription" Style="{StaticResource ManagerTextBoxStyle}" MaxLength="500"
                         Height="80" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalContentAlignment="Top" Padding="12,8"/>
                <CheckBox x:Name="chkIsActive" Content="Đang hoạt động" Margin="0,16,0,0"
                          Foreground="{StaticResource ColorTextPrimary}" IsChecked="True"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="btnCancel" Content="Hủy" Style="{StaticResource ManagerSecondaryButtonStyle}" Click="btnCancel_Click"/>
            <Button x:Name="btnSave" Content="Lưu" Style="{StaticResource ManagerToolbarButtonStyle}" Click="btnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
