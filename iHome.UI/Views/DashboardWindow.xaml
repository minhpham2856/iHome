<Window x:Class="iHome.UI.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shared="clr-namespace:iHome.UI.Views.Shared"
        mc:Ignorable="d"
        Title="iHome - Quản lý nhà trọ sinh viên"
        Height="600"
        Width="1000"
        MinHeight="560"
        MinWidth="900"
        Background="{StaticResource ColorBackground}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <shared:Sidebar x:Name="MainSidebar" Grid.Column="0"/>

        <Grid Grid.Column="1" Background="{StaticResource ColorBackground}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource DashboardHeaderStyle}">
                <Grid Margin="20,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="txtPageTitle"
                               Text="Bảng điều khiển"
                               Style="{StaticResource DashboardHeaderTitleStyle}"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox x:Name="CbProperty"
                                  Style="{StaticResource DashboardPropertyComboBoxStyle}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  Visibility="Collapsed"
                                  SelectionChanged="CbProperty_SelectionChanged"/>
                        <TextBlock x:Name="txtWelcome"
                                   Text="Xin chào"
                                   Style="{StaticResource DashboardWelcomeStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Margin="0">
                <Frame x:Name="mainFrame"
                       NavigationUIVisibility="Hidden"
                       Navigated="mainFrame_Navigated"/>
            </Border>
        </Grid>
    </Grid>
</Window>
