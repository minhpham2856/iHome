<Page x:Class="iHome.UI.Views.Manager.GuestsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Quản lý khách">

    <Grid Background="{StaticResource ColorBackground}" TextElement.FontFamily="Segoe UI">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="4,0,4,16">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Quản lý người thuê" Style="{StaticResource ManagerPageTitleStyle}"/>
                <TextBlock Text="Theo dõi thông tin cư trú, hợp đồng và vị trí phòng của người thuê."
                           Style="{StaticResource ManagerPageDescriptionStyle}"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="+ Thêm khách" Style="{StaticResource ManagerToolbarButtonStyle}" Click="AddTenant_Click"/>
                <Button Content="Sửa" Style="{StaticResource ManagerSecondaryButtonStyle}" Click="EditTenant_Click"/>
                <Button Content="Gán vào phòng" Style="{StaticResource ManagerToolbarButtonStyle}" Click="AssignTenant_Click"/>
                <Button Content="Gỡ khỏi HĐ" Style="{StaticResource ManagerSecondaryButtonStyle}" Click="RemoveTenant_Click"/>
                <Button Content="Xóa" Style="{StaticResource ManagerDangerButtonStyle}" Click="DeleteTenant_Click"/>
                <Button x:Name="BtnRefresh" Content="↻ Làm mới" Style="{StaticResource ManagerSecondaryButtonStyle}" Click="BtnRefresh_Click"/>
            </StackPanel>
        </Grid>

        <UniformGrid Grid.Row="1" Columns="4" Margin="4,0,-6,14">
            <Border Style="{StaticResource ManagerKpiCardStyle}"><StackPanel><TextBlock Text="TỔNG NGƯỜI THUÊ" Style="{StaticResource ManagerKpiLabelStyle}"/><TextBlock x:Name="TxtTotalTenants" Style="{StaticResource ManagerKpiPrimaryValueStyle}"/></StackPanel></Border>
            <Border Style="{StaticResource ManagerKpiCardStyle}"><StackPanel><TextBlock Text="NGƯỜI THUÊ CHÍNH" Style="{StaticResource ManagerKpiLabelStyle}"/><TextBlock x:Name="TxtMainTenants" Style="{StaticResource ManagerKpiInfoValueStyle}"/></StackPanel></Border>
            <Border Style="{StaticResource ManagerKpiCardStyle}"><StackPanel><TextBlock Text="NGƯỜI Ở CÙNG" Style="{StaticResource ManagerKpiLabelStyle}"/><TextBlock x:Name="TxtRoommates" Style="{StaticResource ManagerKpiValueStyle}"/></StackPanel></Border>
            <Border Style="{StaticResource ManagerKpiCardStyle}" Margin="0"><StackPanel><TextBlock Text="SẮP HẾT HẠN" Style="{StaticResource ManagerKpiLabelStyle}"/><TextBlock x:Name="TxtExpiringTenants" Style="{StaticResource ManagerKpiDangerValueStyle}"/></StackPanel></Border>
        </UniformGrid>

        <Border Grid.Row="2" Style="{StaticResource ManagerCardStyle}" Margin="4,0,4,14" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0"><TextBlock Text="TÊN, CCCD HOẶC SỐ ĐIỆN THOẠI" Style="{StaticResource ManagerFilterLabelStyle}"/><TextBox x:Name="TxtSearch" Style="{StaticResource ManagerTextBoxStyle}" TextChanged="FilterChanged"/></StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="TÒA NHÀ" Style="{StaticResource ManagerFilterLabelStyle}"/><ComboBox x:Name="CboBuilding" Style="{StaticResource ManagerComboBoxStyle}" SelectionChanged="BuildingFilterChanged"/></StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,12,0"><TextBlock Text="PHÒNG" Style="{StaticResource ManagerFilterLabelStyle}"/><ComboBox x:Name="CboRoom" Style="{StaticResource ManagerComboBoxStyle}" SelectionChanged="FilterChanged"/></StackPanel>
                <StackPanel Grid.Column="3"><TextBlock Text="HỢP ĐỒNG" Style="{StaticResource ManagerFilterLabelStyle}"/><ComboBox x:Name="CboContractStatus" Style="{StaticResource ManagerComboBoxStyle}" SelectionChanged="FilterChanged"/></StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Margin="4,0,4,0" Style="{StaticResource ManagerCardStyle}" Padding="0" CornerRadius="14">
            <Grid>
                <DataGrid x:Name="GuestsGrid" Style="{StaticResource ManagerDataGridStyle}" HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="HỌ TÊN &amp; EMAIL" Width="1.45*" MinWidth="180">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding FullName}" FontWeight="SemiBold" Foreground="{StaticResource ColorTextPrimary}"/><TextBlock Text="{Binding Email}" FontSize="10" Foreground="{StaticResource ColorTextSecondary}" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="CCCD / ĐIỆN THOẠI" Width="1.15*" MinWidth="145">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding IdCardNumber}"/><TextBlock Text="{Binding PhoneNumber}" FontSize="10" Foreground="{StaticResource ColorTextSecondary}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="VỊ TRÍ" Width="1*" MinWidth="120">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding BuildingName}" FontWeight="SemiBold" Foreground="{StaticResource ColorPrimary}"/><TextBlock Text="{Binding RoomNumber, StringFormat=Phòng {0}}" FontSize="10" Foreground="{StaticResource ColorTextSecondary}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="HỢP ĐỒNG" Width="1.4*" MinWidth="165">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center"><TextBlock FontSize="11"><Run Text="{Binding StartDate, StringFormat={}{0:dd/MM/yyyy}}"/><Run Text=" - "/><Run Text="{Binding EndDate, StringFormat={}{0:dd/MM/yyyy}}"/></TextBlock><TextBlock Text="{Binding ContractStatusDisplay}" FontSize="10" Foreground="{StaticResource ColorTextSecondary}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="VAI TRÒ" Width="1.1*" MinWidth="125">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><Border Style="{StaticResource ManagerTagStyle}"><TextBlock Text="{Binding TenantRoleDisplay}" Style="{StaticResource ManagerTagTextStyle}"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="TRẠNG THÁI" Width="1.1*" MinWidth="125">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ManagerContractStatusTagStyle}">
                                        <TextBlock Text="{Binding ContractStatusDisplay}" Style="{StaticResource ManagerContractStatusTextStyle}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <Border x:Name="StatePanel" Background="{StaticResource ColorOverlay}" Visibility="Collapsed" CornerRadius="14"><TextBlock x:Name="StateText" Style="{StaticResource ManagerStateTextStyle}"/></Border>
            </Grid>
        </Border>

        <TextBlock x:Name="TxtResultCount" Grid.Row="4" Margin="10,10,4,0" Foreground="{StaticResource ColorTextSecondary}" FontSize="12"/>
    </Grid>
</Page>
