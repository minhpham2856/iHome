<Window x:Class="iHome.UI.Views.Manager.InvoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thông tin hóa đơn"
        Width="980" Height="720" MinWidth="900" MinHeight="650"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource ColorBackground}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtTitle" Text="Tạo hóa đơn tháng" Style="{StaticResource ManagerDialogTitleStyle}"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="HỢP ĐỒNG" Style="{StaticResource ManagerDialogLabelStyle}"/>
                <ComboBox x:Name="CbContract"
                          Style="{StaticResource ManagerComboBoxStyle}"
                          DisplayMemberPath="DisplayName"
                          SelectionChanged="BillingInputChanged"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="THÁNG LẬP HÓA ĐƠN" Style="{StaticResource ManagerDialogLabelStyle}"/>
                <DatePicker x:Name="DtpInvoiceDate"
                            Style="{StaticResource ManagerDatePickerStyle}"
                            SelectedDateChanged="BillingInputChanged"/>
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="HẠN THANH TOÁN" Style="{StaticResource ManagerDialogLabelStyle}"/>
                <DatePicker x:Name="DtpDueDate" Style="{StaticResource ManagerDatePickerStyle}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource ManagerCardStyle}" Padding="12" Margin="0,16,0,12">
            <TextBlock Text="Tiền phòng và dịch vụ cố định được tự động lấy theo hợp đồng/phòng. Chỉ nhập chỉ số mới cho điện, nước hoặc dịch vụ tính theo đồng hồ."
                       Foreground="{StaticResource ColorTextSecondary}" TextWrapping="Wrap"/>
        </Border>

        <Grid Grid.Row="3">
            <DataGrid x:Name="ItemsGrid"
                      Style="{StaticResource ManagerDataGridStyle}"
                      AutoGenerateColumns="False"
                      IsReadOnly="False"
                      CanUserAddRows="False"
                      HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="KHOẢN THU" Binding="{Binding Description}" Width="1.7*" MinWidth="180" IsReadOnly="True"/>
                    <DataGridTextColumn Header="CÁCH TÍNH" Binding="{Binding CalculationDisplay}" Width="0.9*" MinWidth="105" IsReadOnly="True"/>
                    <DataGridTextColumn Header="CHỈ SỐ CŨ" Binding="{Binding PreviousReading, StringFormat={}{0:N2}}" Width="0.8*" MinWidth="90" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="CHỈ SỐ MỚI" Width="0.9*" MinWidth="105">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding CurrentReading}"
                                         IsEnabled="{Binding RequiresReading}"
                                         Style="{StaticResource ManagerInvoiceReadingTextBoxStyle}"
                                         TextChanged="CurrentReading_TextChanged"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="SỬ DỤNG" Binding="{Binding Quantity, StringFormat={}{0:N2}}" Width="0.75*" MinWidth="85" IsReadOnly="True"/>
                    <DataGridTextColumn Header="ĐƠN GIÁ" Binding="{Binding UnitPrice, StringFormat={}{0:N0} đ}" Width="0.9*" MinWidth="105" IsReadOnly="True"/>
                    <DataGridTextColumn Header="THÀNH TIỀN" Binding="{Binding Amount, StringFormat={}{0:N0} đ}" Width="1*" MinWidth="115" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
            <Border x:Name="StatePanel" Background="{StaticResource ColorOverlay}" Visibility="Collapsed">
                <TextBlock x:Name="StateText" Style="{StaticResource ManagerStateTextStyle}"/>
            </Border>
        </Grid>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="TRẠNG THÁI" Style="{StaticResource ManagerDialogLabelStyle}"/>
                <ComboBox x:Name="CbStatus" Width="260" HorizontalAlignment="Left"
                          Style="{StaticResource ManagerComboBoxStyle}" DisplayMemberPath="Name"/>
            </StackPanel>
            <Border Grid.Column="2" Style="{StaticResource ManagerInvoiceTotalCardStyle}" Padding="16">
                <StackPanel>
                    <TextBlock Text="TỔNG CỘNG" Style="{StaticResource ManagerKpiLabelStyle}"/>
                    <TextBlock x:Name="TxtTotal" Style="{StaticResource ManagerInvoiceTotalTextStyle}"/>
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Hủy" Style="{StaticResource ManagerSecondaryButtonStyle}" Click="Cancel_Click"/>
            <Button x:Name="BtnSave" Content="Lưu hóa đơn" Style="{StaticResource ManagerToolbarButtonStyle}" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
