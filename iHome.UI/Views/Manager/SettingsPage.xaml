<!-- Cài đặt tài khoản Manager: cột trái = hồ sơ cá nhân, cột phải = đổi mật khẩu -->
<Page x:Class="iHome.UI.Views.Manager.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Cài đặt tài khoản">

	<Grid Background="{StaticResource ColorBackground}" Margin="0">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<Border Grid.Column="0" Style="{StaticResource ManagerCardStyle}" Margin="0" Padding="16"
				BorderThickness="0,0,1,0">
			<ScrollViewer VerticalScrollBarVisibility="Auto">
				<StackPanel>
					<TextBlock Text="Thông tin cá nhân" Style="{StaticResource ManagerSectionTitleStyle}"/>
					<TextBlock Text="TÊN ĐĂNG NHẬP" Style="{StaticResource ManagerDialogLabelStyle}" Margin="0,0,0,6"/>
					<TextBox x:Name="txtUsername" Style="{StaticResource ManagerTextBoxStyle}" MaxLength="20"
							 KeyDown="txtUsername_KeyDown"/>
					<TextBlock Text="VAI TRÒ" Style="{StaticResource ManagerDialogLabelStyle}"/>
					<TextBox x:Name="txtRole" Style="{StaticResource ManagerTextBoxStyle}" IsReadOnly="True"
							 KeyDown="txtRole_KeyDown"/>
					<TextBlock Text="HỌ VÀ TÊN" Style="{StaticResource ManagerDialogLabelStyle}"/>
					<TextBox x:Name="txtFullName" Style="{StaticResource ManagerTextBoxStyle}" MaxLength="100"
							 KeyDown="txtFullName_KeyDown"/>
					<TextBlock Text="EMAIL" Style="{StaticResource ManagerDialogLabelStyle}"/>
					<TextBox x:Name="txtEmail" Style="{StaticResource ManagerTextBoxStyle}" MaxLength="150"
							 KeyDown="txtEmail_KeyDown"/>
					<TextBlock Text="SỐ ĐIỆN THOẠI" Style="{StaticResource ManagerDialogLabelStyle}"/>
					<TextBox x:Name="txtPhone" Style="{StaticResource ManagerTextBoxStyle}" MaxLength="20"
							 KeyDown="txtPhone_KeyDown"/>
					<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
						<Button x:Name="btnSaveProfile" Content="Lưu thông tin" Style="{StaticResource ManagerToolbarButtonStyle}" Click="btnSaveProfile_Click"/>
					</StackPanel>
				</StackPanel>
			</ScrollViewer>
		</Border>

		<Border Grid.Column="1" Style="{StaticResource ManagerCardStyle}" Margin="0" Padding="16">
			<ScrollViewer VerticalScrollBarVisibility="Auto">
				<StackPanel>
					<TextBlock Text="Đổi mật khẩu" Style="{StaticResource ManagerSectionTitleStyle}"/>
					<TextBlock Text="Mật khẩu mới phải 8-20 ký tự, gồm chữ hoa, chữ thường, số và ký tự đặc biệt."
							   Style="{StaticResource ManagerPageDescriptionStyle}" Margin="0,0,0,8"
							   TextWrapping="Wrap"/>
					<TextBlock Text="MẬT KHẨU HIỆN TẠI" Style="{StaticResource ManagerDialogLabelStyle}" Margin="0,0,0,6"/>
					<PasswordBox x:Name="txtOldPassword" Height="38" Padding="12,0"
								 VerticalContentAlignment="Center"
								 BorderBrush="{StaticResource ColorBorder}" BorderThickness="1"
								 Background="{StaticResource ColorSurface}"
								 KeyDown="txtOldPassword_KeyDown"/>
					<TextBlock Text="MẬT KHẨU MỚI" Style="{StaticResource ManagerDialogLabelStyle}"/>
					<PasswordBox x:Name="txtNewPassword" Height="38" Padding="12,0"
								 VerticalContentAlignment="Center"
								 BorderBrush="{StaticResource ColorBorder}" BorderThickness="1"
								 Background="{StaticResource ColorSurface}"
								 KeyDown="txtNewPassword_KeyDown"/>
					<TextBlock Text="XÁC NHẬN MẬT KHẨU MỚI" Style="{StaticResource ManagerDialogLabelStyle}"/>
					<PasswordBox x:Name="txtConfirmPassword" Height="38" Padding="12,0"
								 VerticalContentAlignment="Center"
								 BorderBrush="{StaticResource ColorBorder}" BorderThickness="1"
								 Background="{StaticResource ColorSurface}"
								 KeyDown="txtConfirmPassword_KeyDown"/>
					<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
						<Button x:Name="btnChangePassword" Content="Đổi mật khẩu" Style="{StaticResource ManagerToolbarButtonStyle}" Click="btnChangePassword_Click"/>
					</StackPanel>
				</StackPanel>
			</ScrollViewer>
		</Border>
	</Grid>
</Page>
