<Page x:Class="iHome.UI.Views.Manager.ServicesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Quản lý dịch vụ">

    <Grid Background="{StaticResource ColorBackground}" TextElement.FontFamily="Segoe UI">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="4,0,4,16">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Quản lý dịch vụ" Style="{StaticResource ManagerPageTitleStyle}"/>
                <TextBlock Text="Theo dõi danh mục tiện ích, đơn giá và cách tính theo từng tòa nhà."
                           Style="{StaticResource ManagerPageDescriptionStyle}"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="+ Gán dịch vụ" Style="{StaticResource ManagerToolbarButtonStyle}" Click="AssignService_Click"/>
                <Button Content="Ngừng sử dụng" Style="{StaticResource ManagerDangerButtonStyle}" Click="UnassignService_Click"/>
                <Button Content="Bật lại" Style="{StaticResource ManagerSecondaryButtonStyle}" Click="ReactivateService_Click"/>
                <Button x:Name="BtnRefresh" Content="↻ Làm mới" Style="{StaticResource ManagerSecondaryButtonStyle}" Click="BtnRefresh_Click"/>
            </StackPanel>
        </Grid>

        <UniformGrid Grid.Row="1" Columns="4" Margin="4,0,-6,14">
            <Border Style="{StaticResource ManagerKpiCardStyle}"><StackPanel><TextBlock Text="TỔNG DỊCH VỤ" Style="{StaticResource ManagerKpiLabelStyle}"/><TextBlock x:Name="TxtTotalServices" Style="{StaticResource ManagerKpiPrimaryValueStyle}"/></StackPanel></Border>
            <Border Style="{StaticResource ManagerKpiCardStyle}"><StackPanel><TextBlock Text="ĐANG HOẠT ĐỘNG" Style="{StaticResource ManagerKpiLabelStyle}"/><TextBlock x:Name="TxtActiveServices" Style="{StaticResource ManagerKpiInfoValueStyle}"/></StackPanel></Border>
            <Border Style="{StaticResource ManagerKpiCardStyle}"><StackPanel><TextBlock Text="THEO CHỈ SỐ" Style="{StaticResource ManagerKpiLabelStyle}"/><TextBlock x:Name="TxtMeteredServices" Style="{StaticResource ManagerKpiValueStyle}"/></StackPanel></Border>
            <Border Style="{StaticResource ManagerKpiCardStyle}" Margin="0"><StackPanel><TextBlock Text="NGỪNG HOẠT ĐỘNG" Style="{StaticResource ManagerDangerLabelStyle}"/><TextBlock x:Name="TxtInactiveServices" Style="{StaticResource ManagerKpiDangerValueStyle}"/></StackPanel></Border>
        </UniformGrid>

        <Border Grid.Row="2" Style="{StaticResource ManagerCardStyle}" Margin="4,0,4,14" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0"><TextBlock Text="TÌM KIẾM DỊCH VỤ" Style="{StaticResource ManagerFilterLabelStyle}"/><TextBox x:Name="TxtSearch" Style="{StaticResource ManagerTextBoxStyle}" TextChanged="FilterChanged"/></StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="TÒA NHÀ" Style="{StaticResource ManagerFilterLabelStyle}"/><ComboBox x:Name="CboBuilding" Style="{StaticResource ManagerComboBoxStyle}" SelectionChanged="FilterChanged"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="TRẠNG THÁI" Style="{StaticResource ManagerFilterLabelStyle}"/><ComboBox x:Name="CboStatus" Style="{StaticResource ManagerComboBoxStyle}" SelectionChanged="FilterChanged"/></StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Margin="4,0,4,0" Style="{StaticResource ManagerCardStyle}" Padding="6" CornerRadius="14">
            <TabControl Background="{StaticResource ColorSurface}" BorderThickness="0">
                <TabItem Header="Danh mục &amp; đơn giá (chỉ xem)">
                    <Grid>
                        <DataGrid x:Name="ServicesGrid" Style="{StaticResource ManagerDataGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="TÒA NHÀ" Binding="{Binding BuildingName}" Width="1.1*" MinWidth="110" ElementStyle="{StaticResource ManagerDataGridTextStyle}"/>
                                <DataGridTextColumn Header="DỊCH VỤ" Binding="{Binding ServiceName}" Width="1.45*" MinWidth="140" ElementStyle="{StaticResource ManagerDataGridStrongTextStyle}"/>
                                <DataGridTextColumn Header="ĐƠN VỊ" Binding="{Binding Unit}" Width="0.75*" MinWidth="80" ElementStyle="{StaticResource ManagerDataGridTextStyle}"/>
                                <DataGridTextColumn Header="ĐƠN GIÁ" Binding="{Binding UnitPrice, StringFormat={}{0:N0} đ}" Width="1*" MinWidth="110" ElementStyle="{StaticResource ManagerDataGridLinkTextStyle}"/>
                                <DataGridTemplateColumn Header="CÁCH TÍNH" Width="1.1*" MinWidth="120"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Style="{StaticResource ManagerTagStyle}"><TextBlock Text="{Binding CalculationMethodDisplay}" Style="{StaticResource ManagerTagTextStyle}"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="TRẠNG THÁI" Width="1.15*" MinWidth="125"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Style="{StaticResource ManagerServiceStatusTagStyle}"><TextBlock Text="{Binding StatusDisplay}" Style="{StaticResource ManagerServiceStatusTextStyle}"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border x:Name="StatePanel" Background="{StaticResource ColorOverlay}" Visibility="Collapsed" CornerRadius="14"><TextBlock x:Name="StateText" Style="{StaticResource ManagerStateTextStyle}"/></Border>
                    </Grid>
                </TabItem>
                <TabItem Header="Dịch vụ đã gán theo phòng">
                    <DataGrid x:Name="AssignmentsGrid" Style="{StaticResource ManagerDataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TÒA NHÀ" Binding="{Binding BuildingName}" Width="1.2*" MinWidth="120" ElementStyle="{StaticResource ManagerDataGridTextStyle}"/>
                            <DataGridTextColumn Header="PHÒNG" Binding="{Binding RoomNumber}" Width="0.8*" MinWidth="80" ElementStyle="{StaticResource ManagerDataGridStrongTextStyle}"/>
                            <DataGridTextColumn Header="DỊCH VỤ" Binding="{Binding ServiceName}" Width="1.4*" MinWidth="140" ElementStyle="{StaticResource ManagerDataGridTextStyle}"/>
                            <DataGridTextColumn Header="ĐƠN GIÁ CỦA CHỦ TRỌ" Binding="{Binding UnitPrice, StringFormat={}{0:N0} đ}" Width="1.3*" MinWidth="150" ElementStyle="{StaticResource ManagerDataGridStrongTextStyle}"/>
                            <DataGridTextColumn Header="ĐƠN VỊ" Binding="{Binding Unit}" Width="0.8*" MinWidth="80" ElementStyle="{StaticResource ManagerDataGridTextStyle}"/>
                            <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding StatusDisplay}" Width="1.1*" MinWidth="120" ElementStyle="{StaticResource ManagerDataGridTextStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </Border>

        <TextBlock x:Name="TxtResultCount" Grid.Row="4" Margin="10,10,4,0" Foreground="{StaticResource ColorTextSecondary}" FontSize="12"/>
    </Grid>
</Page>
