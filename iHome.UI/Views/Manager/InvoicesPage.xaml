<Page x:Class="iHome.UI.Views.Manager.InvoicesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Quản lý hóa đơn">
    <Grid Background="{StaticResource ColorBackground}" TextElement.FontFamily="Segoe UI">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="4,0,4,16">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Quản lý hóa đơn" Style="{StaticResource ManagerPageTitleStyle}"/><TextBlock Text="Lập, cập nhật và theo dõi thanh toán cho hợp đồng thuộc tòa nhà được phân công." Style="{StaticResource ManagerPageDescriptionStyle}"/></StackPanel>
            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="+ Tạo hóa đơn" Style="{StaticResource ManagerToolbarButtonStyle}" Click="AddInvoice_Click"/>
                <Button Content="Sửa" Style="{StaticResource ManagerSecondaryButtonStyle}" Click="EditInvoice_Click"/>
                <Button Content="Xuất CSV" Style="{StaticResource ManagerSecondaryButtonStyle}" Click="ExportInvoice_Click"/>
                <Button Content="Xóa" Style="{StaticResource ManagerDangerButtonStyle}" Click="DeleteInvoice_Click"/>
                <Button x:Name="BtnRefresh" Content="↻ Làm mới" Style="{StaticResource ManagerSecondaryButtonStyle}" Click="BtnRefresh_Click"/>
            </StackPanel>
        </Grid>
        <UniformGrid Grid.Row="1" Columns="4" Margin="4,0,-6,14">
            <Border Style="{StaticResource ManagerKpiCardStyle}"><StackPanel><TextBlock Text="TỔNG HÓA ĐƠN" Style="{StaticResource ManagerKpiLabelStyle}"/><TextBlock x:Name="TxtTotal" Style="{StaticResource ManagerKpiPrimaryValueStyle}"/></StackPanel></Border>
            <Border Style="{StaticResource ManagerKpiCardStyle}"><StackPanel><TextBlock Text="CHƯA THANH TOÁN" Style="{StaticResource ManagerKpiLabelStyle}"/><TextBlock x:Name="TxtUnpaid" Style="{StaticResource ManagerKpiInfoValueStyle}"/></StackPanel></Border>
            <Border Style="{StaticResource ManagerKpiCardStyle}"><StackPanel><TextBlock Text="QUÁ HẠN" Style="{StaticResource ManagerDangerLabelStyle}"/><TextBlock x:Name="TxtOverdue" Style="{StaticResource ManagerKpiDangerValueStyle}"/></StackPanel></Border>
            <Border Style="{StaticResource ManagerKpiCardStyle}" Margin="0"><StackPanel><TextBlock Text="CÒN PHẢI THU" Style="{StaticResource ManagerKpiLabelStyle}"/><TextBlock x:Name="TxtOutstanding" Style="{StaticResource ManagerKpiValueStyle}" FontSize="20"/></StackPanel></Border>
        </UniformGrid>
        <Border Grid.Row="2" Style="{StaticResource ManagerCardStyle}" Margin="4,0,4,14" Padding="16">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0"><TextBlock Text="TÌM KIẾM" Style="{StaticResource ManagerFilterLabelStyle}"/><TextBox x:Name="TxtSearch" Style="{StaticResource ManagerTextBoxStyle}" TextChanged="FilterChanged"/></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="TRẠNG THÁI" Style="{StaticResource ManagerFilterLabelStyle}"/><ComboBox x:Name="CboStatus" Style="{StaticResource ManagerComboBoxStyle}" SelectionChanged="FilterChanged"/></StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="3" Margin="4,0,4,0" Style="{StaticResource ManagerCardStyle}" Padding="0" CornerRadius="14">
            <Grid>
                <DataGrid x:Name="InvoicesGrid" Style="{StaticResource ManagerDataGridStyle}" HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="MÃ HĐƠN" Binding="{Binding Id, StringFormat=HĐƠN #{0}}" Width="0.8*" MinWidth="90" ElementStyle="{StaticResource ManagerDataGridLinkTextStyle}"/>
                        <DataGridTextColumn Header="TÒA NHÀ" Binding="{Binding BuildingName}" Width="1.1*" MinWidth="110" ElementStyle="{StaticResource ManagerDataGridTextStyle}"/>
                        <DataGridTextColumn Header="PHÒNG" Binding="{Binding RoomNumber}" Width="0.7*" MinWidth="70" ElementStyle="{StaticResource ManagerDataGridStrongTextStyle}"/>
                        <DataGridTextColumn Header="NGƯỜI THUÊ" Binding="{Binding MainTenantName}" Width="1.35*" MinWidth="145" ElementStyle="{StaticResource ManagerDataGridTextStyle}"/>
                        <DataGridTextColumn Header="NGÀY LẬP" Binding="{Binding InvoiceDate, StringFormat={}{0:dd/MM/yyyy}}" Width="0.95*" MinWidth="105" ElementStyle="{StaticResource ManagerDataGridTextStyle}"/>
                        <DataGridTextColumn Header="HẠN THANH TOÁN" Binding="{Binding DueDate, StringFormat={}{0:dd/MM/yyyy}}" Width="1.05*" MinWidth="115" ElementStyle="{StaticResource ManagerDataGridTextStyle}"/>
                        <DataGridTextColumn Header="TỔNG TIỀN" Binding="{Binding TotalAmount, StringFormat={}{0:N0} đ}" Width="1*" MinWidth="115" ElementStyle="{StaticResource ManagerDataGridStrongTextStyle}"/>
                        <DataGridTextColumn Header="CÒN LẠI" Binding="{Binding Balance, StringFormat={}{0:N0} đ}" Width="1*" MinWidth="110" ElementStyle="{StaticResource ManagerDataGridTextStyle}"/>
                        <DataGridTemplateColumn Header="TRẠNG THÁI" Width="1.15*" MinWidth="130"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Style="{StaticResource ManagerInvoiceStatusTagStyle}"><TextBlock Text="{Binding StatusDisplay}" Style="{StaticResource ManagerInvoiceStatusTextStyle}"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <Border x:Name="StatePanel" Background="{StaticResource ColorOverlay}" Visibility="Collapsed" CornerRadius="14"><TextBlock x:Name="StateText" Style="{StaticResource ManagerStateTextStyle}"/></Border>
            </Grid>
        </Border>
        <TextBlock x:Name="TxtResultCount" Grid.Row="4" Margin="10,10,4,0" Foreground="{StaticResource ColorTextSecondary}" FontSize="12"/>
    </Grid>
</Page>
