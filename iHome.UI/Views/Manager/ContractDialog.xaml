<Window x:Class="iHome.UI.Views.Manager.ContractDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thông tin hợp đồng"
        Width="580" Height="820" MinHeight="700"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource ColorBackground}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="TxtTitle" Text="Tạo hợp đồng" Style="{StaticResource ManagerDialogTitleStyle}"/>
                <TextBlock Text="PHÒNG" Style="{StaticResource ManagerDialogLabelStyle}"/>
                <ComboBox x:Name="CbRoom" Style="{StaticResource ManagerComboBoxStyle}" DisplayMemberPath="DisplayName"
                          SelectionChanged="RoomChanged" KeyDown="CbRoom_KeyDown"/>
                <TextBlock x:Name="TxtRoomCapacity" Style="{StaticResource ManagerPageDescriptionStyle}"
                           Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

                <TextBlock Text="NGƯỜI THUÊ CHÍNH" Style="{StaticResource ManagerDialogLabelStyle}"/>
                <ComboBox x:Name="CbMainTenant" Style="{StaticResource ManagerComboBoxStyle}" DisplayMemberPath="DisplayName"
                          SelectionChanged="MainTenantChanged" KeyDown="CbMainTenant_KeyDown"/>

                <!-- Phòng MaxOccupancy > 1: tick đủ khách đứng tên còn lại -->
                <Border x:Name="CoTenantPanel" Visibility="Collapsed" Margin="0,12,0,0"
                        Background="{StaticResource ColorSurfaceHover}" Padding="12" CornerRadius="8"
                        BorderBrush="{StaticResource ColorBorder}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="TxtCoTenantTitle" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{StaticResource ColorTextPrimary}"
                                   Text="Khách đứng tên còn lại"/>
                        <TextBlock x:Name="TxtCoTenantGuide" Style="{StaticResource ManagerPageDescriptionStyle}"
                                   Margin="0,6,0,10" TextWrapping="Wrap"
                                   Text="Phòng này cần đủ số khách đứng tên trên hợp đồng. Tiền thuê tính chung, không chia theo từng người."/>
                        <ItemsControl x:Name="LstCoTenants">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding DisplayName}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Margin="0,4,0,4"
                                              FontSize="13"
                                              Checked="CoTenantCheckChanged"
                                              Unchecked="CoTenantCheckChanged"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="TxtSelectionStatus" Margin="0,8,0,0" FontWeight="SemiBold"
                                   Foreground="{StaticResource ColorPrimary}" FontSize="12"/>
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="NGÀY BẮT ĐẦU" Style="{StaticResource ManagerDialogLabelStyle}"/>
                        <DatePicker x:Name="DtpStart" Style="{StaticResource ManagerDatePickerStyle}" KeyDown="DtpStart_KeyDown"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="NGÀY KẾT THÚC" Style="{StaticResource ManagerDialogLabelStyle}"/>
                        <DatePicker x:Name="DtpEnd" Style="{StaticResource ManagerDatePickerStyle}" KeyDown="DtpEnd_KeyDown"/>
                    </StackPanel>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="TIỀN THUÊ / THÁNG" Style="{StaticResource ManagerDialogLabelStyle}"/>
                        <TextBox x:Name="TxtRent" Style="{StaticResource ManagerTextBoxStyle}" KeyDown="TxtRent_KeyDown"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="TIỀN CỌC" Style="{StaticResource ManagerDialogLabelStyle}"/>
                        <TextBox x:Name="TxtDeposit" Style="{StaticResource ManagerTextBoxStyle}" KeyDown="TxtDeposit_KeyDown"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="TRẠNG THÁI" Style="{StaticResource ManagerDialogLabelStyle}"/>
                <ComboBox x:Name="CbStatus" Style="{StaticResource ManagerComboBoxStyle}" DisplayMemberPath="Name"
                          KeyDown="CbStatus_KeyDown"/>
                <TextBlock Text="GHI CHÚ" Style="{StaticResource ManagerDialogLabelStyle}"/>
                <TextBox x:Name="TxtNotes" Style="{StaticResource ManagerTextBoxStyle}" MaxLength="300"
                         KeyDown="TxtNotes_KeyDown"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Hủy" Style="{StaticResource ManagerSecondaryButtonStyle}" Click="Cancel_Click"/>
            <Button x:Name="BtnSave" Content="Lưu" Style="{StaticResource ManagerToolbarButtonStyle}" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
