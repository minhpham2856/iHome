<Window x:Class="iHome.UI.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:iHome.UI.Views"
        mc:Ignorable="d"
        Title="iHome - Quản lý nhà trọ sinh viên" Height="450" Width="300"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Logo -->
        <Image Source="pack://application:,,,/Assets/Images/logo.png" 
               Grid.Row="0"
               Style="{StaticResource AuthLogoStyle}"/>

        <!-- Username -->
        <TextBlock Grid.Row="1" Text="Tên đăng nhập"
                   Style="{StaticResource AuthFieldLabelStyle}"/>

        <TextBox Grid.Row="2" Name="txtUsername" 
                 Style="{StaticResource AuthTextBoxStyle}"
                 KeyDown="txtUsername_KeyDown"/>

        <!-- Password -->
        <TextBlock Grid.Row="3" Text="Mật khẩu"
                   Style="{StaticResource AuthFieldLabelStyle}"/>

        <PasswordBox Grid.Row="4" Name="txtPassword" 
                     Style="{StaticResource AuthPasswordBoxStyle}"
                     KeyDown="txtPassword_KeyDown"/>

        <!-- Forgot Password -->
        <TextBlock x:Name="tbForgotPassword" Grid.Row="5" 
                   Style="{StaticResource AuthLinkTextStyle}"
                   MouseDown="tbForgotPassword_MouseDown">
            <Hyperlink TextDecorations="None" Click="Hyperlink_Click">
                Quên mật khẩu?
            </Hyperlink>
        </TextBlock>

        <!-- Login Button -->
        <Button Grid.Row="5" Name="btnLogin" 
                Content="ĐĂNG NHẬP"
                VerticalAlignment="Bottom"
                Style="{StaticResource PrimaryActionButtonStyle}"
                Click="btnLogin_Click"/>
    </Grid>
</Window>
