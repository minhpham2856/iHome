<Window x:Class="iHome.UI.Views.ForgotPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:iHome.UI.Views"
        mc:Ignorable="d"
        Title="iHome - Quản lý nhà trọ sinh viên" Height="450" Width="300"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Logo -->
        <Image Source="pack://application:,,,/Assets/Images/logo.png" 
           Grid.Row="0"
           Height="100" Width="100" 
           HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <!-- Email -->
        <TextBlock Grid.Row="1" Text="Email" 
               FontWeight="SemiBold" FontSize="12"
               Foreground="{StaticResource ColorPrimary}"
               Margin="0,0,0,5"/>

        <TextBox Grid.Row="2" Name="txtEmail" 
             Height="35" Margin="0,0,0,15"
             FontSize="14" Padding="10,0,10,0"
             BorderThickness="1.5"
             BorderBrush="{StaticResource ColorBorderLight}"
             Background="{StaticResource ColorSurfaceLight}"
             VerticalContentAlignment="Center"
             KeyDown="txtEmail_KeyDown">
            <TextBox.Style>
                <Style TargetType="TextBox">
                    <Setter Property="Foreground" Value="{StaticResource ColorPrimary}"/>
                    <Style.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource ColorPrimary}"/>
                            <Setter Property="Background" Value="{StaticResource ColorSurface}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TextBox.Style>
        </TextBox>

        <!-- Return to login -->
        <TextBlock x:Name="tbReturnToLogin" Grid.Row="5" 
               HorizontalAlignment="Right"
               VerticalAlignment="Top"
               Foreground="{StaticResource ColorLink}"
               FontSize="11"
               FontWeight="SemiBold"
               Cursor="Hand"
               Margin="0,0,0,15"
               MouseDown="tbReturnToLogin_MouseDown">
            <Hyperlink TextDecorations="None" Click="Hyperlink_Click">
                Quay lại đăng nhập
            </Hyperlink>    
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource ColorDanger}"/>
                            <Setter Property="TextDecorations" Value="none"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Recover Password Button -->
        <Button Grid.Row="5" Name="btnRecoverPassword" 
            Content="GỬI EMAIL KHÔI PHỤC"
            Height="40" 
            VerticalAlignment="Bottom"
            FontWeight="Bold" FontSize="14"
            Foreground="{StaticResource ColorSurface}"
            Background="{StaticResource ColorPrimary}"
            BorderThickness="0"
            Cursor="Hand"
            Click="btnLogin_Click">
            <Button.Style>
                <Style TargetType="Button">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" 
                                    Value="{StaticResource ColorDanger}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" 
                                    Value="{StaticResource ColorDanger}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</Window>
