<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared palette: minhpn design - black primary, red accent, square geometry. -->
    <SolidColorBrush x:Key="ColorPrimary" Color="#000000"/>
    <SolidColorBrush x:Key="ColorPrimaryHover" Color="#555555"/>
    <SolidColorBrush x:Key="ColorPrimaryPressed" Color="#FF0000"/>
    <SolidColorBrush x:Key="ColorDanger" Color="#FF0000"/>
    <SolidColorBrush x:Key="ColorDangerSoft" Color="#FFE5E5"/>
    <SolidColorBrush x:Key="ColorInfo" Color="#5555FF"/>
    <SolidColorBrush x:Key="ColorInfoSoft" Color="#E9EEFF"/>
    <SolidColorBrush x:Key="ColorSuccess" Color="#16794B"/>
    <SolidColorBrush x:Key="ColorSuccessSoft" Color="#DCF4E7"/>
    <SolidColorBrush x:Key="ColorBackground" Color="#F5F7FA"/>
    <SolidColorBrush x:Key="ColorSurface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ColorSurfaceLight" Color="#F9F9F9"/>
    <SolidColorBrush x:Key="ColorSurfaceHover" Color="#EEEEEE"/>
    <SolidColorBrush x:Key="ColorBorder" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="ColorBorderLight" Color="#DDDDDD"/>
    <SolidColorBrush x:Key="ColorTextPrimary" Color="#2C3E50"/>
    <SolidColorBrush x:Key="ColorTextSecondary" Color="#555555"/>
    <SolidColorBrush x:Key="ColorOnPrimary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ColorOnPrimaryMuted" Color="#DADADA"/>
    <SolidColorBrush x:Key="ColorLink" Color="#5555FF"/>
    <SolidColorBrush x:Key="ColorLinkHover" Color="#FF0000"/>
    <SolidColorBrush x:Key="ColorDisabled" Color="#999999"/>
    <SolidColorBrush x:Key="ColorOverlay" Color="#F2FFFFFF"/>

    <!-- Authentication -->
    <Style x:Key="AuthLogoStyle" TargetType="Image">
        <Setter Property="Height" Value="100"/>
        <Setter Property="Width" Value="100"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,0,20"/>
    </Style>

    <Style x:Key="AuthFieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource ColorPrimary}"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>

    <Style x:Key="AuthTextBoxStyle" TargetType="TextBox">
        <Setter Property="Height" Value="35"/>
        <Setter Property="Margin" Value="0,0,0,15"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Foreground" Value="{StaticResource ColorPrimary}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorderLight}"/>
        <Setter Property="Background" Value="{StaticResource ColorSurfaceLight}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource ColorPrimary}"/>
                <Setter Property="Background" Value="{StaticResource ColorSurface}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AuthPasswordBoxStyle" TargetType="PasswordBox">
        <Setter Property="Height" Value="35"/>
        <Setter Property="Margin" Value="0,0,0,15"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Foreground" Value="{StaticResource ColorPrimary}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorderLight}"/>
        <Setter Property="Background" Value="{StaticResource ColorSurfaceLight}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource ColorPrimary}"/>
                <Setter Property="Background" Value="{StaticResource ColorSurface}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AuthLinkTextStyle" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Foreground" Value="{StaticResource ColorLink}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource ColorLinkHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource ColorSurface}"/>
        <Setter Property="Background" Value="{StaticResource ColorPrimary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="0"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource ColorDanger}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource ColorPrimaryPressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Shared Sidebar -->
    <Style x:Key="SidebarContainerStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ColorSurface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorder}"/>
        <Setter Property="BorderThickness" Value="0,0,1,0"/>
    </Style>

    <Style x:Key="SidebarLogoHostStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ColorSurface}"/>
        <Setter Property="Padding" Value="10"/>
    </Style>

    <Style x:Key="SidebarButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="45"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource ColorPrimary}"/>
        <Setter Property="Background" Value="{StaticResource ColorSurfaceHover}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="15,0,0,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="SidebarButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="0"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SidebarButtonBorder" Property="Background" Value="{StaticResource ColorPrimary}"/>
                            <Setter Property="Foreground" Value="{StaticResource ColorSurface}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="SidebarButtonBorder" Property="Background" Value="{StaticResource ColorDanger}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Background" Value="{StaticResource ColorPrimary}"/>
                <Setter Property="Foreground" Value="{StaticResource ColorOnPrimary}"/>
                <Setter Property="BorderBrush" Value="{StaticResource ColorDanger}"/>
                <Setter Property="BorderThickness" Value="0,0,4,0"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SidebarLogoutButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryActionButtonStyle}">
        <Setter Property="Height" Value="40"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{StaticResource ColorPrimary}"/>
    </Style>

    <!-- Dashboard shell -->
    <Style x:Key="DashboardHeaderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ColorSurface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorder}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <Style x:Key="DashboardHeaderTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource ColorTextPrimary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="DashboardPropertyComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Width" Value="210"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Margin" Value="0,0,16,0"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{StaticResource ColorSurfaceLight}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorder}"/>
    </Style>

    <Style x:Key="DashboardWelcomeStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource ColorTextSecondary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Existing shared Landlord-compatible styles. -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ColorSurface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="8"/>
    </Style>

    <Style x:Key="KpiTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource ColorTextSecondary}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <Style x:Key="KpiValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource ColorTextPrimary}"/>
    </Style>

    <Style x:Key="ChartTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource ColorTextPrimary}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!-- Manager UI: all styles and state triggers are centralized here. -->
    <Style x:Key="ManagerPageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource ColorTextPrimary}"/>
    </Style>

    <Style x:Key="ManagerPageDescriptionStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource ColorTextSecondary}"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <Style x:Key="ManagerSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource ColorTextPrimary}"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <Style x:Key="ManagerCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ColorSurface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="18"/>
    </Style>

    <Style x:Key="ManagerKpiCardStyle" TargetType="Border" BasedOn="{StaticResource ManagerCardStyle}">
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
        <Setter Property="MinHeight" Value="84"/>
    </Style>

    <Style x:Key="ManagerKpiLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource ColorTextSecondary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="ManagerKpiValueStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="27"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource ColorTextPrimary}"/>
        <Setter Property="Margin" Value="0,5,0,0"/>
    </Style>

    <Style x:Key="ManagerKpiPrimaryValueStyle" TargetType="TextBlock" BasedOn="{StaticResource ManagerKpiValueStyle}">
        <Setter Property="Foreground" Value="{StaticResource ColorPrimary}"/>
    </Style>

    <Style x:Key="ManagerKpiInfoValueStyle" TargetType="TextBlock" BasedOn="{StaticResource ManagerKpiValueStyle}">
        <Setter Property="Foreground" Value="{StaticResource ColorInfo}"/>
    </Style>

    <Style x:Key="ManagerKpiDangerValueStyle" TargetType="TextBlock" BasedOn="{StaticResource ManagerKpiValueStyle}">
        <Setter Property="Foreground" Value="{StaticResource ColorDanger}"/>
    </Style>

    <Style x:Key="ManagerDangerLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource ManagerKpiLabelStyle}">
        <Setter Property="Foreground" Value="{StaticResource ColorDanger}"/>
    </Style>

    <Style x:Key="ManagerFilterLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource ColorTextSecondary}"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style x:Key="ManagerTextBoxStyle" TargetType="TextBox">
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{StaticResource ColorSurface}"/>
        <Setter Property="Foreground" Value="{StaticResource ColorTextPrimary}"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource ColorPrimary}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ManagerComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="10,0,28,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{StaticResource ColorSurface}"/>
        <Setter Property="Foreground" Value="{StaticResource ColorTextPrimary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource ColorPrimary}"/>
                <Setter Property="Background" Value="{StaticResource ColorSurfaceHover}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource ColorPrimary}"/>
            </Trigger>
            <Trigger Property="IsDropDownOpen" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource ColorPrimary}"/>
                <Setter Property="Background" Value="{StaticResource ColorSurfaceHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FilterDatePickerStyle" TargetType="DatePicker">
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="Background" Value="{StaticResource ColorSurface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource ColorTextPrimary}"/>
    </Style>

    <Style x:Key="FilterInlineLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource KpiTitleStyle}">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="ManagerRefreshButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryActionButtonStyle}">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height" Value="32"/>
    </Style>

    <Style x:Key="ManagerToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryActionButtonStyle}">
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinWidth" Value="92"/>
        <Setter Property="Margin" Value="6,0,0,0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="ManagerSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ManagerToolbarButtonStyle}">
        <Setter Property="Background" Value="{StaticResource ColorSurface}"/>
        <Setter Property="Foreground" Value="{StaticResource ColorTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="ManagerDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ManagerToolbarButtonStyle}">
        <Setter Property="Background" Value="{StaticResource ColorDanger}"/>
    </Style>

    <Style x:Key="ManagerDialogLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource ManagerFilterLabelStyle}">
        <Setter Property="Margin" Value="0,10,0,6"/>
    </Style>

    <Style x:Key="ManagerDatePickerStyle" TargetType="DatePicker">
        <Setter Property="Height" Value="38"/>
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{StaticResource ColorSurface}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="ManagerDialogTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource ManagerPageTitleStyle}">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style x:Key="ManagerDataGridHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource ColorSurfaceHover}"/>
        <Setter Property="Foreground" Value="{StaticResource ColorTextSecondary}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorder}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border x:Name="HeaderBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                            <TextBlock x:Name="SortGlyph" Grid.Column="1"
                                       Margin="8,0,0,0"
                                       FontSize="10"
                                       Foreground="{StaticResource ColorTextSecondary}"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed"
                                       Text="▼"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SortGlyph" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="SortGlyph" Property="Text" Value="▲▼"/>
                            <Setter TargetName="HeaderBorder" Property="Background" Value="{StaticResource ColorSurfaceLight}"/>
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Ascending">
                            <Setter TargetName="SortGlyph" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="SortGlyph" Property="Text" Value="▲"/>
                            <Setter TargetName="SortGlyph" Property="Foreground" Value="{StaticResource ColorPrimary}"/>
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Descending">
                            <Setter TargetName="SortGlyph" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="SortGlyph" Property="Text" Value="▼"/>
                            <Setter TargetName="SortGlyph" Property="Foreground" Value="{StaticResource ColorPrimary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ManagerDataGridRowStyle" TargetType="DataGridRow">
        <Setter Property="Background" Value="{StaticResource ColorSurface}"/>
        <Setter Property="Foreground" Value="{StaticResource ColorTextPrimary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ColorSurfaceLight}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource ColorSurfaceHover}"/>
                <Setter Property="Foreground" Value="{StaticResource ColorTextPrimary}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ManagerDataGridCellStyle" TargetType="DataGridCell">
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorderLight}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ManagerDataGridTextStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource ColorTextPrimary}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>

    <Style x:Key="ManagerDataGridStrongTextStyle" TargetType="TextBlock" BasedOn="{StaticResource ManagerDataGridTextStyle}">
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="ManagerDataGridLinkTextStyle" TargetType="TextBlock" BasedOn="{StaticResource ManagerDataGridTextStyle}">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource ColorPrimary}"/>
    </Style>

    <Style x:Key="ManagerDataGridStyle" TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="GridLinesVisibility" Value="None"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="{StaticResource ColorSurface}"/>
        <Setter Property="RowHeight" Value="54"/>
        <Setter Property="ColumnHeaderHeight" Value="48"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource ManagerDataGridHeaderStyle}"/>
        <Setter Property="RowStyle" Value="{StaticResource ManagerDataGridRowStyle}"/>
        <Setter Property="CellStyle" Value="{StaticResource ManagerDataGridCellStyle}"/>
    </Style>

    <Style x:Key="ManagerTagStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ColorInfoSoft}"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="9,4"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="ManagerTagTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ColorInfo}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Full-cell active / inactive status for landlord property & building grids -->
    <Style x:Key="LandlordActiveStatusCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource ManagerDataGridCellStyle}">
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Background" Value="{StaticResource ColorSuccessSoft}"/>
        <Setter Property="Foreground" Value="{StaticResource ColorSuccess}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsActive}" Value="False">
                <Setter Property="Background" Value="{StaticResource ColorDangerSoft}"/>
                <Setter Property="Foreground" Value="{StaticResource ColorDanger}"/>
            </DataTrigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource ColorSuccessSoft}"/>
