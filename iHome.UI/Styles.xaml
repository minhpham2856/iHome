<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Color palette -->
    <SolidColorBrush x:Key="ColorPrimary" Color="#000"/>
    <SolidColorBrush x:Key="ColorPrimaryHover" Color="#555"/>
    <SolidColorBrush x:Key="ColorPrimaryPressed" Color="#f00"/>
    <SolidColorBrush x:Key="ColorDanger" Color="#f00"/>
    <SolidColorBrush x:Key="ColorBackground" Color="#F5F7FA"/>
    <SolidColorBrush x:Key="ColorSurface" Color="#fff"/>
    <SolidColorBrush x:Key="ColorSurfaceLight" Color="#F9F9F9"/>
    <SolidColorBrush x:Key="ColorSurfaceHover" Color="#eee"/>
    <SolidColorBrush x:Key="ColorBorder" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="ColorBorderLight" Color="#ddd"/>
    <SolidColorBrush x:Key="ColorTextPrimary" Color="#2C3E50"/>
    <SolidColorBrush x:Key="ColorTextSecondary" Color="#555"/>
    <SolidColorBrush x:Key="ColorLink" Color="#55f"/>
    <SolidColorBrush x:Key="ColorLinkHover" Color="#5ff"/>
    <SolidColorBrush x:Key="ColorDisabled" Color="#999"/>

    <!-- Style for sidebar button -->
    <Style x:Key="SidebarButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="45"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource ColorPrimary}"/>
        <Setter Property="Background" Value="{StaticResource ColorSurfaceHover}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="15,0,0,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ColorPrimary}"/>
                <Setter Property="Foreground" Value="{StaticResource ColorSurface}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource ColorDanger}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Style for a surface card (dashboard KPI tiles) -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ColorSurface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="8"/>
    </Style>

    <!-- Small label above a KPI value -->
    <Style x:Key="KpiTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource ColorTextSecondary}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <!-- Large KPI number -->
    <Style x:Key="KpiValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource ColorTextPrimary}"/>
    </Style>

    <!-- Section heading above a chart -->
    <Style x:Key="ChartTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource ColorTextPrimary}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

</ResourceDictionary>